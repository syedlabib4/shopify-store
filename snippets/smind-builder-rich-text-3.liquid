{% assign block_color = section.blocks | where: 'type', 'color' | first %}
{% liquid
	assign content_alignment = section.settings.content_alignment
	assign color_pos = 0
	assign bkg_pos = 0
	for block in section.blocks
		if block.type == 'color'
			assign color_pos = forloop.index
		endif
		if block.type == 'background'
			assign bkg_pos = forloop.index
		endif
	endfor
%}
<div
	id="smi-{{ section.id }}"
	class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }}
  smi-section__inner smi-gradient smi-section-rich-text-3 smi-color-{{ section.settings.color_scheme }} smi-content-settings"
	data-section="rich-text-3" data-name="✧Rich text 3">
	
	{% liquid
		assign background_block = section.blocks | where: 'type', 'background' | first
		if background_block
			render 'smi-background', section: section, is_reference: true
		endif
	%}
	{% assign color_block = section.blocks | where: 'type', 'color' | first %}
	<div class="smi-container-relative smi-container{%- if section.settings.full_width -%}-fluid{%- endif -%}">
		{%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
		<div
			class="smi-container-detail smi-section-block-{{ section.id }} {% if section.settings.content_max_width < 576 %}min-container{% endif %} smi-content-position-{{ section.settings.content_position }} {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in smi-animate-order-1 {% endif -%}"
			data-block='{
        "color_pos": "{{ color_pos }}",
        "bkg_pos": "{{ bkg_pos }}",
        "all_block": {{ section.blocks.size }}
      }'
		>
			<div
				class=" smi-overflow-hidden smi-content-wrapper smi-content-max-width smi-shadow smi-border">
				<div
					class="smi-rich-text-detail smi-gradient smi-content-color smi-color-{{ section.settings.content_color_scheme }}">
					{% for block in section.blocks %}
						<div class="smi-block-position-{{ forloop.index }}-{{ section.id }}
            content-alignment-{{ section.settings.content_alignment -}}
                {{- ' smi-rich-content' -}}
                {%- if block.type == "icon_with_text" %} smi-rich-content-half-{{ block.settings.half_width_on_large_screen }}{% endif -%}
                {%- liquid
							if block.type != 'color' and block.type != 'background'
								if block.type == 'button'
									if forloop.index < section.blocks.size
										echo ' smi-mb-lg'
									endif
								else
									if forloop.index < section.blocks.size
										echo ' smi-mb-lg'
									endif
								endif
							endif
						%}
                {{- ' smi-block-type-' | append: block.type -}}" {{ block.shopify_attributes }}>
							{% if block.type == 'heading' %}
								{% assign style = section.settings.highlighted_style | strip %}
								{% assign icon = section.settings.highlighted_label | strip %}
								{% assign button_more_label = section.settings.read_more_button %}
								{% assign button_less_label = section.settings.read_less_button %}
								{% assign line_clamp = section.settings.max_lines | to_integer %}
								{% assign text_truncate_expand = section.settings.text_truncate_expand %}
								{% assign content_alignment = section.settings.content_alignment %}
								{%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div
	class="smi-heading-component smi-heading-component--align-{{ block.settings.heading_alignment }}" {{- block.shopify_attributes -}} >
	{% liquid
		assign heading = block.settings.heading | strip
		assign sub_heading = block.settings.sub_heading | strip
		assign description = block.settings.description | strip
		assign heading_tags = block.settings.heading_tags | default:'h2'
		assign heading_size = block.settings.heading_size
		assign sub_heading_size = block.settings.sub_heading_size
	%}
	{%- if style != 'none' -%}
		{%- capture begin_tag -%}<em>{%- endcapture -%}
		{%- assign heading = heading | replace: '<em>', begin_tag -%}
		{%- if style == 'scribble' -%}
			{%- capture end_tag -%}
				{%- capture class -%}icon icon-{{ icon | handle }}{% if class != blank %} {{ class }}{% endif %}{%- endcapture -%}
				{%- case icon -%}
					{%- when 'circle' -%}
						<svg class="{{ class }}" viewBox="0 0 800 350" stroke="currentColor" fill="none"
							 role="presentation" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
							<path transform="matrix(0.9791300296783447,0,0,0.9791300296783447,400,179)"
