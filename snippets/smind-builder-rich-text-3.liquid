						</svg>
					{%- when 'basic-underline' -%}
						<svg class="{{ class }}" viewBox="0 0 185 16" stroke="currentColor" fill="none"
							 role="presentation" preserveAspectRatio="none"
							 xmlns="http://www.w3.org/2000/svg">
							<path
