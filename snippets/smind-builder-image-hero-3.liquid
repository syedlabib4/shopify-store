on-image-hero-3 .smi-block-icon_with_text .smi-list-icon-content{display:flex;gap:16px;flex-wrap:wrap}.smi-section-image-hero-3 .smi-block-icon_with_text .smi-icon-item{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px}.smi-section-image-hero-3 .smi-block-icon_with_text .smi-icon{display:flex;width:calc(var(--icon-size)*var(--icon-scale, 1));height:calc(var(--icon-size)*var(--icon-scale, 1))}.smi-section-image-hero-3 .smi-block-icon_with_text .smi-icon svg,.smi-section-image-hero-3 .smi-block-icon_with_text .smi-icon img{width:100%;height:100%;object-fit:cover}.smi-section-image-hero-3 .smi-block-icon_with_text .smi-text-content{text-align:center}.smi-section-image-hero-3 .smi-block-testimonial{display:flex;justify-content:var(--content-alignment)}.smi-section-image-hero-3 .smi-block-testimonial .smi-testimonial-wrapper{display:flex;flex-direction:column;gap:16px;align-items:var(--content-alignment);text-align:var(--content-alignment)}.smi-section-image-hero-3 .smi-block-testimonial .smi-icon{display:flex;width:calc(var(--icon-size)*var(--icon-scale, 1));height:calc(var(--icon-size)*var(--icon-scale, 1))}.smi-section-image-hero-3 .smi-block-testimonial .smi-icon svg,.smi-section-image-hero-3 .smi-block-testimonial .smi-icon img{width:100%;height:100%;object-fit:cover}.smi-section-image-hero-3 .smi-block-testimonial .smi-author-content{display:flex;align-items:center;gap:16px}.smi-section-image-hero-3 .smi-block-testimonial .smi-author-avatar{display:flex;width:var(--avatar-size);height:var(--avatar-size);border-radius:50%;overflow:hidden;flex:none}.smi-section-image-hero-3 .smi-block-testimonial .smi-author-avatar svg,.smi-section-image-hero-3 .smi-block-testimonial .smi-author-avatar img{width:100%;height:100%;object-fit:cover}.smi-section-image-hero-3 .smi-block-testimonial .smi-author-name{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.smi-text-detail-lg-item{color:var(--basieco-iteem);background:var(--podes-ite2m)}
</style>
<script src="{{ 'smi-video.min.js' | asset_url }}" defer data-id="smi-video.min.js" data-section-id="smi-{{ section.id }}"></script>
<link rel="stylesheet" type="text/css" href="{{ 'smi-video.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-countdown-timer-new-2.min.js' | asset_url }}" defer data-id="smi-countdown-timer-new-2.min.js" data-section-id="smi-{{ section.id }}"></script>
<div id="smi-{{ section.id }}" class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-section-image-hero-3 smi-color-{{ section.settings.color_scheme }}" data-section="image-hero-3" data-name="✧Image hero 3">
    
    {% liquid
        assign background_block = section.blocks | where: 'type', 'background' | first
        if background_block
            render 'smi-background', section: section, is_reference: true
        endif
    %}
	<div class="smi-{{ section.settings.full_width }}">
		<div class="smi-image-hero-wrapper  smi-d-flex smi-gradient {% if section.settings.hero_height == 'adapt_to_image' %} smi-adapt-image-desktop {% endif %} {% if section.settings.hero_height_mobile == 'adapt_to_image' %} smi-adapt-image-mobile {% endif %} {{ custom_color_content }} {{ position_content }} {% if section.settings.full_width != 'container-fluid-no-padding' %} smi-content-wrapper smi-border smi-shadow {% endif %}" data-ratio-desktop="{{ aspect_ratio_md }}" data-ratio-mobile="{{ aspect_ratio_xs }} ">
			{% liquid
  assign background_animation = section.settings.animation
  assign background_image_class = ''
if background_animation == 'parallax' 
	assign background_image_class = 'smi-is-parallax'
endif
%}
<div class="smi-hero-background smi-absolute-full smi-background-block--{{background_animation }}" smind-key="type_media,hero_height" smind-attributes smind-attr-media>
	{% if section.settings.type_media == 'image' %}
		{% liquid
			assign background_image = images[section.settings.image]
        	assign background_image_mobile = images[section.settings.mobile_image_optional]
		%}	
		{% if background_image != blank or background_image_mobile != blank %}
			<picture>
				{%- if background_image_mobile != blank -%}
					<source media="(max-width:460px)" srcset="{{ background_image_mobile | image_url: width : 700 }}">
					<source media="(max-width:767px)" srcset="{{ background_image_mobile | image_url: width : 1100 }}">
				{%- endif -%}
				{%- if background_image != blank -%}
					{% if background_image_mobile == blank %}
						<source media="(max-width:460px)" srcset="{{ background_image | image_url: width : 700 }}">
						<source media="(max-width:767px)" srcset="{{ background_image | image_url: width : 1100 }}">
					{% endif %}
					{{ background_image | image_url: width : 1920 | image_tag: class: background_image_class }}
				{%- elsif background_image_mobile != blank -%}
					{% assign background_image_class = background_image_class | append: ' smi-image-mobile' %}
					{{ background_image_mobile | image_url: width : 767 | image_tag: class: background_image_class }}
				{%- endif -%}
			</picture>
        {% endif %}
	{% else %}
		{% render 'smi-video', 
			video_url: section.settings.video_url, 
			upload_video: section.settings.video,
			upload_video_mobile: section.settings.mobile_video_optional,
			autoplay: true, 
			show_mute:section.settings.enable_sound_control,
			fit_video: true,
			placeholder_name: 'lifestyle-1',
      		placeholder_class: 'smi-placeholder-light' 
		,
      section: section,
      block: block,
      is_reference: true,
      section_id_origin: section_id_origin
    					%}
	{% endif %}	
</div>
			<div class="smi-image-hero-content ">
				{% for block in section.blocks %}
					{% liquid
						assign exclude = 'color, background'
						if exclude contains block.type
							continue
						endif
					%}		
					<div id="smi-{{ block.id }}" class="smi-block-{{ block.type }} smi-image-hero-block" {{ block.shopify_attributes }}>
						{% if block.type == 'rating_icons' %}
							<div class="smi-component-rating-icons-wrapper">
	<div class="smi-component-rating-icons smi-component-rating-icons-{{ block.id }} smi-column-gap-xs smi-row-gap-xs {% if block.settings.show_background %} smi-has-background {% endif %}">
		<style>
			.smi-component-rating-icons-{{ block.id }} {
				--icon-size: {{ block.settings.icon_size_desktop }}px;
				--icon-gap: {{ block.settings.icon_gap_desktop }}px;
				--icon-color: {{ block.settings.icon_color }};
				--image-width: {{ block.settings.image_width }}px;
				--content-direction: {{ block.settings.direction_desktop }};
				{% if block.settings.direction_desktop == 'row' %}
					align-items: center;
				{% else  %}	
					align-items: var(--content-alignment,start);
					text-align: var(--content-alignment,start);
				{% endif %}	
				{% if block.settings.custom_text_color %}
					--text-color: {{ block.settings.text_color | color_extract: 'red' }},{{ block.settings.text_color | color_extract: 'green' }},{{ block.settings.text_color | color_extract: 'blue' }};
				{% endif %}	
				{% if block.settings.show_background %}
					--border-thickness: {{ block.settings.border_thickness }}px;
					--thickness-opacity: {{ block.settings.thickness_opacity | divided_by: 100.0 }};
					--thickness-color: {{ block.settings.thickness_color | color_extract: 'red' }}, {{ block.settings.thickness_color | color_extract: 'green' }}, {{ block.settings.thickness_color | color_extract: 'blue' }};
					--padding_scale: {{ block.settings.padding_scale_desktop | divided_by: 100.0 }};
					--icon-background: {{ block.settings.icon_background | color_extract: 'red' }}, {{ block.settings.icon_background | color_extract: 'green' }}, {{ block.settings.icon_background | color_extract: 'blue' }};
					--icon-background-opacity: {{ block.settings.icon_background_opacity | divided_by: 100.0 }};
					--borner-radius: {{ block.settings.borner_radius }}px;
				{% endif %}	
			}
			@media(max-width:767.8px) {
				.smi-component-rating-icons-{{ block.id }} {
					--icon-size: {{ block.settings.icon_size_mobile }}px;
					--icon-gap: {{ block.settings.icon_gap_mobile }}px;
					--content-direction: {{ block.settings.direction_mobile }};
					{% if block.settings.show_background %}
						--padding_scale: {{ block.settings.padding_scale_mobile | divided_by: 100.0 }};
					{% endif %}	
					{% if block.settings.direction_mobile == 'row' %}
						align-items: center;
					{% else %}	
						align-items: var(--content-alignment,start);
						text-align: var(--content-alignment,start);
					{% endif %}
				}
			}
		</style>
		{% if images[block.settings.upload_image] != blank or block.settings.type_star == 'icon' %}
			<div class="smi-rating-icons-wrapper smi-rating-icons-{{ block.id }} ">
				{% if block.settings.type_star == 'image' %}
					{%- if images[block.settings.upload_image] != blank -%}
						{% assign image_width = block.settings.image_width | times: 2 %}
						{{ images[block.settings.upload_image] | image_url: width: 750 | image_tag: loading: 'eager' }}
					{%- endif -%}
				{% else %}
					<div class="smi-rating-icons smi-d-inline-flex smi-align-items-center">
	{% liquid
		assign icon_style = block.settings.icon_style
		assign star = block.settings.number_icon | times: 1
		assign star_floor = star | floor
		assign star_ceil = star | ceil
		assign icon_color = block.settings.icon_color
	%}
    {% for i in (1..5) %}
        {%- if i <= star_floor -%}
            <span>{% render 'rating-icons', icon_style: icon_style ,icon_type:"fill", icon_color: icon_color ,
      section: section,
      block: block,
      is_reference: true,
      section_id_origin: section_id_origin
    					%}</span>
        {% elsif i > star_floor and i <= star_ceil %}
            <span>{% render 'rating-icons', icon_style: icon_style ,icon_type:"half", icon_color: icon_color ,
      section: section,
      block: block,
      is_reference: true,
      section_id_origin: section_id_origin
    					%}</span>
        {% elsif i > star_ceil  %}
            <span>{% render 'rating-icons', icon_style: icon_style ,icon_type:"outline",icon_color: icon_color  ,
      section: section,
      block: block,
      is_reference: true,
      section_id_origin: section_id_origin
    					%}</span>
        {%- endif -%}
    {% endfor %}
</div>
				{% endif %}		
			</div>
		{% endif %}
		{% if block.settings.rating_text != blank %}
			{%- assign rating_text_size = '-mb ' | append:block.settings.rating_text_size  | prepend: block.settings.rating_text_size -%}
			<div class="smi-rating-text {{ rating_text_size }} {% if block.settings.custom_text_color %} smi-custom-text-color {% endif %}">
				{{ block.settings.rating_text }}
			</div>
		{% endif %}	
	</div>
</div>
						{% endif %}
						{% if block.type == 'spacer' %}
							<style>
	#smi-{{ block.id }} .smi-spacer{
		width: 100%;
		height: {{ block.settings.desktop_size }}px;
	}
	@media(max-width:767px) {
		#smi-{{ block.id }} .smi-spacer{
			height: {{ block.settings.mobile_size }}px;
		}
	}
</style>
<div class="smi-spacer">&nbsp</div>
						{% endif %}	
						{% if block.type == 'divider' %}
<style>
	#smi-{{ block.id }} .smi-diviver{
		--divider-opacity: {{ block.settings.opacity_divider | divided_by: 100.0 }};
		width: 100%;
		height: {{ block.settings.thickness_divider }}px;
		background: rgba(var(--color-foreground), var(--divider-opacity));
	}
</style>
<div class="smi-diviver">&nbsp</div>
						{% endif %}	
						{% if block.type == 'social_proof' %}
							<style>
	#smi-{{ block.id }} .smi-social-proof {
		--avatar-size: {{ block.settings.avatar_size }}px;
	}
