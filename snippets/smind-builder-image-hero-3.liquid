{% comment %}#component#["settings/display-settings-2","settings/container-width-new","settings/content-settings-2.schema2","settings/section-padding","settings/section-margin","settings/rating-icons","settings/heading","settings/buttons","settings/button-animation","settings/countdown-timer-new-2","settings/video.no-autoplay","settings/icon-setting","blocks/background","settings/custom-icons","settings/design-mode","settings/image.vars","settings/image","settings/animation-settings"]#endcomponent#{% endcomment %}
{% liquid
	assign list_blogs = section.blocks
	case section.settings.hero_height
        when 'adapt_to_image'
			if section.settings.type_media == 'image'
				assign aspect_ratio_md = images[section.settings.image].aspect_ratio | default: 1.77
			else
				if section.settings.video != blank
                	assign aspect_ratio_md = section.settings.video.aspect_ratio
				else
					assign aspect_ratio_md = 16.0 | divided_by: 9.0
				endif
			endif
			assign slide_height = '100%'
        when 'x_small'
            assign slide_height = '400px'
        when 'small'
            assign slide_height = '512px'
        when 'medium'
            assign slide_height = '576px'
        when 'large'
            assign slide_height = '672px'
        when 'fit_screen'
            assign slide_height = '100vh'
    endcase
	case section.settings.hero_height_mobile
		when 'adapt_to_image'
			if section.settings.type_media == 'image'
				assign aspect_ratio_xs = images[section.settings.mobile_image_optional].aspect_ratio | default: aspect_ratio_md
			else
				assign aspect_ratio_xs = section.settings.mobile_video_optional.aspect_ratio | default: aspect_ratio_md
			endif
			assign slide_height_mobile = '100%'
        when 'custom'
			assign slide_height_mobile = section.settings.custom_height_mobile | append: 'px'
        when 'fit_screen'
            assign slide_height_mobile = '100vh'
	endcase
	assign block_color = section.blocks | where: 'type', 'color' | first
    if block_color
        assign custom_color_content = 'smi-content-color'
    else
        assign custom_color_content = 'smi-color-' | append: section.settings.content_color_scheme
    endif
	assign position_y = section.settings.desktop_content_position | split: '_' | first
	assign position_x = section.settings.desktop_content_position | split: '_' | last
	capture position_content
		echo ' smi-justify-content-center smi-align-items-' | append: section.settings.mobile_content_position
		if section.settings.desktop_content_position
		echo ' smi-justify-content-md-' | append: position_x | append: ' smi-align-items-md-' | append: position_y
		endif
	endcapture
	assign desktop_content_alignment = section.settings.desktop_content_alignment
	if section.settings.desktop_content_alignment == 'right'
		assign desktop_content_alignment = 'end'
	endif
	assign mobile_content_alignment = section.settings.mobile_content_alignment
	if section.settings.mobile_content_alignment == 'right'
		assign mobile_content_alignment = 'end'
	endif
%}
