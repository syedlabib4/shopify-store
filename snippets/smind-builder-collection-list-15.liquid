{% comment %}#component#["settings/display-settings-2","settings/heading","settings/content-alignment","settings/media-settings-3","settings/custom-media-style.using-for-section","layout/slider.no-columns","settings/layout-settings.container-max-width","settings/display-settings","settings/section-padding","settings/section-margin","settings/collection-list-item-5","blocks/color","blocks/background","settings/slider-arrows","settings/slider-dots-v2","settings/animation-settings","settings/design-mode","layout/slider","settings/image.vars","settings/image"]#endcomponent#{% endcomment %}
{% liquid
  assign object_loop = section.blocks | where: 'type', 'collection'
%}
<style>
    {% if block_color %}
    {% endif %}
    {% assign colorblock = section.blocks | where: 'type', 'color' | first %}
{% if colorblock %}
	.smi-quick-view-1-modal-{{ section.id }}, #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }},
      .smi-block-custom-color {
		--color-background: {{ colorblock.settings.background_color | color_extract: 'red' }}, {{ colorblock.settings.background_color | color_extract: 'green' }},{{ colorblock.settings.background_color | color_extract: 'blue' }};
		--color-background-alpha: {{ colorblock.settings.background_color | color_extract: 'alpha' | default: 1 }};
        {% if colorblock.settings.background_gradient_color == blank %}
            --gradient-background: {{ colorblock.settings.background_color }};
        {% else %}
            --gradient-background: {{ colorblock.settings.background_gradient_color }};
        {% endif %}
		{% if colorblock.settings.heading_color != blank and colorblock.settings.heading_color != 'rgba(0,0,0,0)' %}
			--color-heading: {{ colorblock.settings.heading_color | color_extract: 'red' }}, {{ colorblock.settings.heading_color | color_extract: 'green' }},{{ colorblock.settings.heading_color | color_extract: 'blue' }};
		{% endif %}	
		--color-foreground-hex: {{ colorblock.settings.text_color }};
        --color-foreground: {{ colorblock.settings.text_color | color_extract: 'red' }}, {{ colorblock.settings.text_color | color_extract: 'green' }},{{ colorblock.settings.text_color | color_extract: 'blue' }};
		--color-subtext: {{ colorblock.settings.subtext_color | color_extract: 'red' }},{{ colorblock.settings.subtext_color | color_extract: 'green' }},{{ colorblock.settings.subtext_color | color_extract: 'blue' }};
        --color-shadow: {{ colorblock.settings.shadow_color | color_extract: 'red' }}, {{ colorblock.settings.shadow_color | color_extract: 'green' }},{{ colorblock.settings.shadow_color | color_extract: 'blue' }};
		--color-text-link: {{ colorblock.settings.link_color | color_extract: 'red' }}, {{ colorblock.settings.link_color | color_extract: 'green' }},{{ colorblock.settings.link_color | color_extract: 'blue' }};
		{% if colorblock.settings.hover_link_color != blank and colorblock.settings.hover_link_color != 'rgba(0,0,0,0)' %}
			--color-hover-link: {{ colorblock.settings.hover_link_color | color_extract: 'red' }}, {{ colorblock.settings.hover_link_color | color_extract: 'green' }},{{ colorblock.settings.hover_link_color | color_extract: 'blue' }};
		{% else %}
			--color-hover-link: {{ colorblock.settings.link_color | color_extract: 'red' }}, {{ colorblock.settings.link_color | color_extract: 'green' }},{{ colorblock.settings.link_color | color_extract: 'blue' }};
		{% endif %}		
		--color-button: {{ colorblock.settings.solid_background_button_color | color_extract: 'red' }}, {{ colorblock.settings.solid_background_button_color | color_extract: 'green' }},{{ colorblock.settings.solid_background_button_color | color_extract: 'blue' }};
		--color-button-text: {{ colorblock.settings.solid_button_label_color | color_extract: 'red' }}, {{ colorblock.settings.solid_button_label_color | color_extract: 'green' }},{{ colorblock.settings.solid_button_label_color | color_extract: 'blue' }};
		{% if colorblock.settings.solid_background_button_hover_color != blank and colorblock.settings.solid_background_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover: {{ colorblock.settings.solid_background_button_hover_color | color_extract: 'red' }}, {{ colorblock.settings.solid_background_button_hover_color | color_extract: 'green' }},{{ colorblock.settings.solid_background_button_hover_color | color_extract: 'blue' }};
		{% else %}
			--color-button-hover: {{ colorblock.settings.solid_background_button_color | color_extract: 'red' }}, {{ colorblock.settings.solid_background_button_color | color_extract: 'green' }},{{ colorblock.settings.solid_background_button_color | color_extract: 'blue' }};
		{% endif %}		
		{% if colorblock.settings.solid_button_label_hover_color != blank and colorblock.settings.solid_button_label_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover-text: {{ colorblock.settings.solid_button_label_hover_color | color_extract: 'red' }}, {{ colorblock.settings.solid_button_label_hover_color | color_extract: 'green' }},{{ colorblock.settings.solid_button_label_hover_color | color_extract: 'blue' }};
		{% else %}
			--color-button-hover-text: {{ colorblock.settings.solid_button_label_color | color_extract: 'red' }}, {{ colorblock.settings.solid_button_label_color | color_extract: 'green' }},{{ colorblock.settings.solid_button_label_color | color_extract: 'blue' }};
		{% endif %}		
		--color-secondary-button-text: {{ colorblock.settings.outline_button_color | color_extract: 'red' }}, {{ colorblock.settings.outline_button_color | color_extract: 'green' }},{{ colorblock.settings.outline_button_color | color_extract: 'blue' }};
		{% if colorblock.settings.outline_button_hover_color != blank and colorblock.settings.outline_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover-border: {{ colorblock.settings.outline_button_hover_color | color_extract: 'red' }}, {{ colorblock.settings.outline_button_hover_color | color_extract: 'green' }},{{ colorblock.settings.outline_button_hover_color | color_extract: 'blue' }};
		{% else %}
			--color-button-hover-border: {{ colorblock.settings.outline_button_color | color_extract: 'red' }}, {{ colorblock.settings.outline_button_color | color_extract: 'green' }},{{ colorblock.settings.outline_button_color | color_extract: 'blue' }};
		{% endif %}		
    }
{% endif %}
    #shopify-section-{{ section.id }}{
        --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
        --heading-alignment: {%- liquid
    case  section.settings.heading_alignment
        when 'left'
         echo 'start'
        when 'right'
         echo 'end'
        else
         echo 'center'
    endcase
-%};
		--section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
        --grid-mobile-horizontal-spacing: {{  section.settings.item_gap_on_mobile }}px;
        --grid-desktop-horizontal-spacing: {{  section.settings.item_gap_on_desktop }}px;
    }
    #shopify-section-{{ section.id }} .smi-collection-list-wrapper{
        --container-max-width: {{ section.settings.container_max_width }}px;
    }
	#smi-{{ section.id }} .smi-collection-item-5__content .__smi-heading{
		--content-font-family: var(--font-{{ section.settings.font_type }}-family);
		--content-font-weight: var(--font-{{ section.settings.font_type }}-weight);
		--content-font-style: var(--font-{{ section.settings.font_type }}-style);
	}
	{% if section.settings.customize_media_style %}
		#shopify-section-{{ section.id }} .smi-collection-item-5__media .smi-media-wrapper {
			--border-width: {{ section.settings.media_border_thickness }}px;
			--border-opacity: {{ section.settings.media_border_opacity | divided_by: 100.0 }};
			--border-radius: {{ section.settings.media_radius }}px;
			--shadow-opacity: {{ section.settings.media_shadow_opacity | divided_by: 100.0 }};
			{% if section.settings.custom_media_shadow %}
				--shadow-horizontal-offset: {{ section.settings.media_shadow_position_x }}px;
				--shadow-vertical-offset: {{ section.settings.media_shadow_position_y }}px;
				--shadow-blur-radius: {{ section.settings.media_shadow_blur }}px;
			{% else %}
				{% assign smi_media_shadow = section.settings.media_shadow | split: "," %}
				--shadow-horizontal-offset: {{ smi_media_shadow[0] }}px;
				--shadow-vertical-offset: {{ smi_media_shadow[1] }}px;
				--shadow-blur-radius: {{ smi_media_shadow[2] }}px;
			{% endif %}		
		}
		@media(max-width:767.98px) {
			#shopify-section-{{ section.id }} .smi-collection-item-5__media .smi-media-wrapper {
				--border-width: {{ section.settings.media_border_thickness_mobile }}px;
				--border-radius: {{ section.settings.media_radius_mobile }}px;
			}
		}
	{% endif %}
@media screen and (max-width: 767.8px){.smi-display-settings.smi-display-desktop{display:none !important}}@media screen and (min-width: 768px){.smi-display-settings.smi-display-mobile{display:none !important}}.smi-collection-item-5{display:flex;flex-direction:column;width:100%;height:100%}.smi-collection-item-5 .smi-collection-item-5__media{width:100%}.smi-collection-item-5 img,.smi-collection-item-5 svg{transition:all .3s ease-in-out !important}.smi-section-collection-list-15{display:none}@media screen and (min-width: 768px){.smi-section-collection-list-15.smi-show-desktop{display:block}}@media screen and (max-width: 767.8px){.smi-section-collection-list-15.smi-show-mobile{display:block}}.smi-section-collection-list-15 .smi-container-fluid .smi-layout-slider .smi-component-arrow-slider{display:flex}.smi-section-collection-list-15 .smi-collection-list-wrapper{width:var(--container-max-width);max-width:100%;margin:auto}.smi-section-collection-list-15 .smi-section-collection-list-15__main .swiper-slide.smi-shadow{box-shadow:none;overflow:visible}.smi-section-collection-list-15 .smi-slider-not-overflow .smi-swiper{overflow:visible}.smi-section-collection-list-15 .smi-slider-not-overflow .smi-swiper .smi-swiper-slide{opacity:0}.smi-section-collection-list-15 .smi-slider-not-overflow .smi-swiper .smi-swiper-slide-visible{opacity:1}.smi-section-collection-list-15 .smi-collection-item-5__content .__smi-heading{font-family:var(--content-font-family);font-weight:var(--content-font-weight);font-style:var(--content-font-style)}
</style>
{%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div id="smi-{{ section.id }}"
     class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-overflow-x-clip smi-section__inner smi-gradient smi-section-collection-list-15 smi-color-{{ section.settings.color_scheme }} {% if section.settings.show_on_desktop %}smi-show-desktop{% endif %} {% if section.settings.show_on_mobile %}smi-show-mobile{% endif %}"
     data-section="collection-list-15"
     data-name="✧Collection list 15">
    
    {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background', section: section, is_reference: true
    endif
  %}
    <div class="smi-container">
        {%-liquid
    if settings.smi_animations_reveal_on_scroll != nil
        assign animation_scroll = settings.smi_animations_reveal_on_scroll
    else
        assign global_settings = shop.metafields.smind.settings.value
        assign animation_scroll = global_settings.revealOnScroll
    endif
-%}
<div
	class="smi-heading-component smi-heading-component--align-{{ section.settings.heading_alignment }} smi-link-wrapper" {{- block.shopify_attributes -}}
	style="--heading-alignment: {{ section.settings.heading_alignment }}">
	{% liquid
		assign heading = section.settings.heading | strip
		assign sub_heading = section.settings.sub_heading | strip
		assign description = section.settings.description | strip
		assign heading_tags = section.settings.heading_tags | default:'h2'
		assign heading_size = section.settings.heading_size
	%}
	<div class="smi-heading-inner
    {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in{% endif -%}
    {%- if heading != blank or sub_heading != blank or description != blank %} smi-mb-xxl{% endif -%}
    ">
		{%- assign sub_heading = section.settings.sub_heading | strip -%}
{%- assign sub_heading_size = blank -%}
{% if section.settings.sub_heading_size != blank %}
	{%- assign sub_heading_size = '-mb ' | append:section.settings.sub_heading_size  | prepend: section.settings.sub_heading_size -%}
{% endif %}
{% if sub_heading != blank %}
    <p class="{% if sub_heading_size != blank %}{{sub_heading_size}}{% else %}smi-text-sub{% endif %} smi-mb-xs smi-heading-component__subheading" smind-key="sub_heading" smind-attributes smind-attr-text>{{- sub_heading -}}</p>
{% endif %}
		{%- assign description = section.settings.description | strip -%}
{%- assign heading = section.settings.heading | strip -%}
{% if heading != blank %}
    <{{heading_tags}} class="{{ heading_size }} {% if description != blank %}smi-mb-sm{% endif %} smi-heading-component__heading" smind-key="heading" smind-attributes smind-attr-text>{{- heading -}}</{{heading_tags}}>
{% endif %}
		{%- assign description = section.settings.description | strip -%}
{%- assign description_size = blank -%}
{% if section.settings.description_size != blank %}
	{%- assign description_size = '-mb ' | append:section.settings.description_size  | prepend: section.settings.description_size -%}
{% endif %}
{% if description != blank %}
    <div class="{% if description_size != blank %}{{description_size}}{% else %}smi-text-md{% endif %} smi-heading-component__description smi-format-content" smind-key="description" smind-attributes smind-attr-text>{{ description }}</div>
{% endif %}
	</div>
</div>
   </div>
   <div class="smi-container-fluid smi-section-collection-list-15__main {%- if animation_scroll %} smi-scroll-trigger smi-animate--slide-in smi-animate-order-1{% endif -%}">
        <div class="smi-collection-list-wrapper">
            {% liquid 
                assign border_style = 'media' 
                assign show_border = false
                assign slides_per_view_laptop = 8
                assign slides_per_view_tablet = 6
            %}
{% liquid
  if object_limit == null
    assign object_length = object_loop | size | times: 1
  else
    assign object_length = object_limit | times: 1
  endif
  case border_style
    when 'none'
      assign border_classes = ' '
    when 'content'
      assign border_classes = ' smi-content-wrapper'
    when 'blog'
      assign border_classes = ' smi-article-card-wrapper'
      if settings.smi_blog_card_style
        assign card_style = settings.smi_blog_card_style
      else
        assign global_settings = shop.metafields.smind.settings.value
        assign card_style = global_settings.blogCardStyle | default: 'standard'
      endif
      if card_style == 'standard'
        assign show_border = false
      endif
    when 'product'
      assign border_classes = ' smi-product-card-wrapper'
	  if section.settings.card_style
	  	assign card_style = section.settings.card_style
	  else
		if settings.smi_card_style
			assign card_style = settings.smi_card_style
		else
			assign global_settings = shop.metafields.smind.settings.value
			assign card_style = global_settings.productCardStyle | default: 'standard'
		endif
	  endif
      if card_style == 'standard'
        assign show_border = false
      endif
    else
      assign border_classes = ' smi-media-wrapper'
  endcase
  if enable_spacing_between_items == null
    assign enable_spacing_between_items = section.settings.enable_spacing_between_items
  endif
  if number_of_columns_on_desktop == null
    assign number_of_columns_on_desktop = section.settings.number_of_columns_on_desktop
  endif
  assign number_of_columns_on_desktop = number_of_columns_on_desktop | times: 1
  if number_of_columns_on_mobile == null
    assign number_of_columns_on_mobile = section.settings.number_of_columns_on_mobile
  endif
  assign number_of_columns_on_mobile = number_of_columns_on_mobile | times: 1
  if auto_rotate_slides == null
    assign auto_rotate_slides = section.settings.auto_rotate_slides
  endif
  if change_slides_every == null
    assign change_slides_every = section.settings.change_slides_every
  endif
  if slider_overflow == null
    assign slider_overflow = section.settings.slider_overflow
  endif
  if show_view_all == null
    assign show_view_all = false
  endif
  unless view_all_button_style
    assign view_all_button_style = section.settings.view_all_button_style
  endunless
  unless view_all_button_link
    assign view_all_button_link = '#'
  endunless
%}
<link rel="stylesheet" type="text/css" href="{{ 'smi-swiper-bundle-v11.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'"> <script src="{{ 'smi-swiper-bundle-v11.min.js' | asset_url }}" defer data-id="smi-swiper-bundle-v11.min.js" data-section-id="smi-{{ section.id }}"></script> <link rel="stylesheet" type="text/css" href="{{ 'smi-layout-slider.min.css' | asset_url }}" media="screen" onload="this.onload=null;this.media='all'">
<script src="{{ 'smi-slider-2.min.js' | asset_url }}" defer data-id="smi-slider-2.min.js" data-section-id="smi-{{ section.id }}"></script>
{% liquid
  if enable_spacing_between_items == false
    assign space_between_mobile = '0px'
    assign space_between_desktop = '0px'
  else
    assign space_between_mobile = 'var(--grid-mobile-horizontal-spacing)'
    assign space_between_desktop = 'var(--grid-desktop-horizontal-spacing)'
  endif
  assign slides_per_view_desktop = number_of_columns_on_desktop | at_least: 1
  assign slides_per_view_laptop = slides_per_view_laptop | default: 3 | at_most: slides_per_view_desktop
  assign slides_per_view_tablet = slides_per_view_tablet | default: 2 | at_most: slides_per_view_desktop
  assign slides_per_view_mobile = number_of_columns_on_mobile | at_least: 1
  if object_length <= slides_per_view_mobile
    assign offset_swiper_mobile = '0px'
  else
    if enable_spacing_between_items == false
      assign offset_swiper_mobile = '(30px + var(--media-border-width))'
    else
      assign offset_swiper_mobile = '30px'
    endif
  endif
  assign number_of_loop = 0
  comment
    Center if item is less than the number of columns in settings
  endcomment
  if object_length < number_of_columns_on_mobile
    assign flex_justify_content = ' smi-justify-content-center'
  elsif object_length < 3 and object_length < number_of_columns_on_desktop
    assign flex_justify_content = ' smi-justify-content-lg-center'
  elsif object_length < number_of_columns_on_desktop
    assign flex_justify_content = ' smi-justify-content-xl-center'
  endif
%}
{% liquid
  assign item_mobile = slides_per_view_mobile
  assign item_tablet = slides_per_view_tablet
  assign item_desktop = slides_per_view_desktop
%}
{% liquid
    unless image_width
        assign image_width = 1600
    endunless
    unless sizes
        assign percent_item_mobile = 100 | divided_by: item_mobile | default: 100
        assign percent_item_tablet = 100 | divided_by: item_tablet | default: 100
        assign percent_item_desktop = 100 | divided_by: item_desktop | default: 100
        assign sizes = '(max-width: 767px)' | append: percent_item_mobile | append: 'vw, (max-width: 991px) ' | append: percent_item_tablet | append: 'vw, ' | append: percent_item_desktop | append: 'vw'
    endunless
%} 
<style>
  #shopify-section-{{ section.id }} {{ slider_wrapper }} {
      --space-between-mobile : {{ space_between_mobile }};
      --space-between-desktop : {{ space_between_desktop }};
      --item-width-xs: calc((100% - (({{ slides_per_view_mobile | minus: 1 }} * var(--space-between-mobile)) + var(--offset-swiper-mobile,{{ offset_swiper_mobile }})))/{{ slides_per_view_mobile }});
      --item-width-md: calc((100% - ({{ slides_per_view_tablet | minus: 1 }} * var(--space-between-desktop)))/{{ slides_per_view_tablet }});
      --item-width-lg: calc((100% - ({{ slides_per_view_laptop | minus: 1 }} * var(--space-between-desktop)))/{{ slides_per_view_laptop }});
      --item-width-xl: calc((100% - ({{ slides_per_view_desktop | minus: 1 }} * var(--space-between-desktop)))/{{ slides_per_view_desktop }});
  }
</style>
<div
  class="
    {{- 'smi-layout-slider smi-position-relative' -}}
    {%- if slider_overflow == true %} smi-slider-overflow{% else %} smi-slider-not-overflow{% endif -%}
    {%- liquid
      echo border_classes | default: ' smi-media-wrapper'
      if enable_spacing_between_items == false
        echo ' smi-border-radius-0'
        if show_border == false
          echo ' smi-gap-0--standard'
        else
          echo ' smi-gap-0'
        endif
      else
        echo ' smi-gap-1'
      endif
      if slides_per_view_desktop == 1
        echo ' smi-content-max-width-800'
      endif
  -%}
  "
>
  <div
    class="smi-swiper"
    {%- if auto_rotate_slides == true %}
      data-swiper-autoplay--delay="{{- change_slides_every | default: 5 | times: 1000 -}}"
    {% endif -%}
	{% if custom_data_swiper %}
		{{ custom_data_swiper }}
	{% endif %}
  >
    <div class="smi-swiper-wrapper {{ flex_justify_content }}">
      {% for item in object_loop limit: object_length %}
        {% liquid
          if exclude contains item.type
            continue
          endif
          assign number_of_loop = number_of_loop | plus: 1
        %}
        <div
          class="
            {%- liquid
              echo 'smi-swiper-slide'
              if show_border != false
                echo ' smi-border'
                if enable_spacing_between_items != false
                  echo ' smi-shadow'
                endif
              endif
            -%}
          "
          data-swiper-slide-index="{{ forloop.index0 }}"
          {{ item.shopify_attributes }}
        >
          {% liquid
    assign block = item
    assign shape_index = 1
    assign show_product_count = section.settings.show_product_count
%}
{% liquid
    assign placeholder_image = 'collection-1' 
    assign collection = collections[block.settings.collection]
    if block.settings.link != blank
      assign link = block.settings.link
    elsif collection != blank
      assign link = collection.url
    else
      assign link = '#'
    endif
    if block.settings.heading != blank
      assign heading = block.settings.heading
    elsif collection != blank
      assign heading = collection.title
    else
      assign heading = ''
    endif
    unless show_product_count
      assign show_product_count = false
    endunless
	assign card_hover_effect = settings.smi_animations_hover_card | default: shop.metafields.smind.settings.value.cardHoverEffect | default: 'none'
%}
{%-liquid
    assign media_ratio = section.settings.media_ratio
    assign media_shape = section.settings.media_shape
    assign media_classes = 'smi-w-100 smi-object-fit-cover '
    if media_shape != 'default' and media_shape != 'round'
        if shape_index > 6
            assign shape_index = 1
        endif
        if shape_index < 6 
            assign forloop_next = shape_index | plus: 1
        else
            assign forloop_next = 1
        endif
        assign media_classes = media_classes | append: ' smi-shape-blob-' | append: shape_index
        assign shape_index = shape_index | plus: 1
        assign shape_hover = '--shape-blob-' | append: forloop_next
    endif
    if media_ratio == 'auto' 
        assign media_classes = media_classes | append: ' smi-h-auto'
    else
        assign media_classes = media_classes | append: ' smi-h-100 smi-p-absolute'
    endif
    assign media_wrapper_classes = 'smi-media-wrapper smi-border smi-shadow smi-lh-0 smi-overflow-hidden smi-p-relative smi-' | append: media_shape
    if media_shape contains 'blob'
        assign media_wrapper_classes = media_wrapper_classes | append: ' smi-blob-wrapper smi-has-blob'
    endif
-%}
<div class="smi-collection-item-5 smi-row-gap-md {{- ' smi-card-hover-' | append: card_hover_effect -}}">
    <div class="smi-collection-item-5__media ">
        <a
            href="{{- link -}}"
            class="{{ media_wrapper_classes }} smi-d-flex {{ settings.smi_animations_hover_image | default: shop.metafields.smind.settings.value.imageHoverEffect | default: 'none' | prepend: ' smi-hover-image-' }}"
            data-type="item-image"
            aria-label="{{ block.id }}"
            style="--media-ratio: {{ media_ratio }}; --shape-hover: var({{ shape_hover }})"
          >
            {% assign image_classes = media_classes %}
            {% assign svg_classes = media_classes | append: ' smi-placeholder-svg smi-placeholder-light' %}
            {% if images[block.settings.image] != blank %}
              {% assign image_object = images[block.settings.image] %}
{{
  image_object
  | image_url: width: image_width
  | image_tag: class: image_classes, widths: '400,500,600,700,800,1000,1200,1400,1600,1900,2500', sizes: sizes
}}
            {% elsif collection.image != blank %}
              {% assign image_object = collection.image %}
{{
  image_object
  | image_url: width: image_width
  | image_tag: class: image_classes, widths: '400,500,600,700,800,1000,1200,1400,1600,1900,2500', sizes: sizes
}}
            {% else %}
              {{ placeholder_image | placeholder_svg_tag: svg_classes }}
            {% endif %}
          </a>
    </div>
    {% if heading != blank %}
      <div class="smi-collection-item-5__content smi-text-{{section.settings.content_alignment}}"> 
              <a href="{{- link -}}" aria-label="{{ block.id }}">
                <h3 class="__smi-heading {{ section.settings.content_heading_size }} smi-link-wrapper" data-type="item-heading">
                  {{ heading }}
                </h3>
              </a>
          {% if show_product_count == true and collection.all_products_count %}
            <div class="smi-count smi-text-md smi-color-text-75">({{ 'smind.collection.product'| t: product_count: collection.all_products_count, count: collection.all_products_count }})</div>
          {% endif %}  
      </div>
    {% endif %}
</div>    
        </div>
      {% endfor %}
    </div>
  </div>
  <div class="smi-slider-controls">
    {% if show_navigation != false %}
      {% liquid
  unless st_navigation
    assign st_navigation = section.settings.arrow_style
  endunless
%}
{% if st_navigation != 'none' %}
  {% liquid
    case st_navigation
      when 'arr-style-2' or 'arr-square-style-4' or 'arr-square-style-5' or 'arr-square-style-6' or 'arr-circle-style-4' or 'arr-circle-style-5' or 'arr-rounded-rectangle-bg' or 'arr-rounded-rectangle'
        capture st_navigation_left
          render 'smi-icons', icon: 'arrow-left-2'
        endcapture
      else
        capture st_navigation_left
          render 'smi-icons', icon: 'arrow-left'
        endcapture
    endcase
  %}
  <div class="smi-component-arrow-slider">
    <div class="arrow-slider-content">
      <div class="{{ st_navigation }} arrow-icon arrow-slider-left smi-cursor-pointer" smind-key="arrow_style" smind-attributes smind-attr-arrow>
        {{ st_navigation_left }}
      </div>
      <div class="{{ st_navigation }} arrow-icon arrow-icon--flip arrow-slider-right smi-cursor-pointer" smind-key="arrow_style" smind-attributes smind-attr-arrow>
            {{ st_navigation_left }}
      </div>
    </div>
  </div>
{% endif %}
    {% endif %}
    {%- liquid
	if st_pagination == null
		assign st_pagination = section.settings.sticky_page_dot_style
	endif
-%}
{% if st_pagination != 'none' %}
	{%- liquid
		assign pagination_style = 'default'
		if st_pagination contains 'text-style'
			assign pagination_style = 'fraction'
		elsif st_pagination == 'dynamic'
			assign pagination_style = 'dynamic'
		elsif st_pagination == 'scrollbar'
			assign pagination_style = 'scrollbar'
		endif
	-%}
	<div class="smi-slider-dot-container smi-pt-xl smi-w-100" data-pagination="{{ pagination_style }}">
		{%- if st_pagination contains 'text-style' -%}
			<div class="smi-component-sticky-page-dot">
				<div class="smi-slider-action">
					<div class="smi-arrows {{ st_pagination }}" smind-key="sticky_page_dot_style,pagination_alignment" smind-attributes smind-attr-pagination>
						<div data-control="textPrevSlide" class="smi-arrow dot-arrow-slider smi-text-sm">
							{% render 'smi-icons', icon: 'arrow-left' %}
						</div>
						<div class="text-pagination smi-pagination smi-slider-pagination smi-text-sm smi-arrow"></div>
						<div data-control="textNextSlide" class="smi-arrow dot-arrow-slider smi-text-sm">
							{% render 'smi-icons', icon: 'arrow-right' %}
						</div>
					</div>
				</div>
			</div>
		{%- elsif st_pagination == 'scrollbar' -%}
			<div class="smi-swiper-scrollbar" smind-key="sticky_page_dot_style,pagination_alignment" smind-attributes smind-attr-pagination></div>
		{%- elsif st_pagination == 'dynamic' -%}
			<div class="smi-pagination" smind-key="sticky_page_dot_style,pagination_alignment" smind-attributes smind-attr-pagination></div>
		{%- else -%}
			<div class="dot-container {{ st_pagination }}">
				<div
					class="smi-swiper-pagination smi-pagination"
					{% if st_pagination == 'dot-style-4' %}
						style="display: flex;"
					{% endif %}
					smind-key="sticky_page_dot_style,pagination_alignment" smind-attributes smind-attr-pagination
				></div>
			</div>
		{%- endif -%}
	</div>
{% endif %}
  </div>
</div>
{%- if show_view_all != false and view_all_button_style != 'none' and number_of_loop > 0 -%}
    <div class="smi-button-wrapper smi-view-all smi-mt-xl smi-d-flex smi-justify-content-center">
      <a
        href="{{- view_all_button_link -}}"
        class="smi-button smi-button--{{- view_all_button_style | split: '_' | first }} smi-text-button {% if view_all_button_style contains "text" %} {% else %}smi-border smi-shadow{% endif %}{{- settings.smi_animations_hover_elements | default: shop.metafields.smind.settings.value.buttonHoverEffect | default: 'none' | prepend: ' smi-hover-' }}" smind-key="button_style" smind-attributes smind-attr-button
      >
        <span>{{ 'smind.general.view_all' | t }}</span>
        {% if view_all_button_style contains 'arrow' %}{% render 'smi-icons', icon: 'arrow-right-2' %}{% endif %}
      </a>
    </div>
  {%- endif -%}
{% if no_js != true %}
  <script type="text/javascript">
    window.smind?.initializeWhenReady(() => {
      const containerEl = document.getElementById('smi-{{ section.id }}');
      const layoutSlider = new SMI_LayoutSlider(containerEl);
      layoutSlider.sliderInit();
    }, ['SMI_LayoutSlider']);
  </script>
{% endif %}
        </div>
    </div>
</div>{%comment%}#includeFile#assets/smi-swiper-bundle-v11.min.css,assets/smi-swiper-bundle-v11.min.js,assets/smi-layout-slider.min.css,assets/smi-slider-2.min.js#endIncludeFile#{%endcomment%}


