{%-liquid
  assign default_object_loop = "null,null,null,null,null,null" | split: ","
  assign object_loop = collections[section.settings.collection].products | default: default_object_loop
  assign object_limit = section.settings.number_items | times: 1
  assign enable_spacing_between_items = section.settings.enable_spacing
  assign view_all_button_style = section.settings.button_style
  assign view_all_button_link = collections[section.settings.collection].url
  assign show_view_all = true
  assign border_style = 'product'
  assign show_navigation = false
  assign arrow_style = section.settings.arrow_style
  assign collection_image = collections[section.settings.collection].featured_image | default: "null"
  assign number_columns_on_desktop = section.settings.number_of_columns_on_desktop
  assign number_of_columns_on_mobile = section.settings.number_of_columns_on_mobile
  case section.settings.desktop_media_width
	when '1'
		assign media_flex_class = 'smi-flex-md-1'
		if number_columns_on_desktop == '2'	
			assign card_flex_class = 'smi-flex-md-1'
			assign number_of_columns_on_desktop = 1
		elsif number_columns_on_desktop == '3'
			assign card_flex_class = 'smi-flex-md-2'
			assign number_of_columns_on_desktop = 2
		elsif number_columns_on_desktop == '4'
			assign card_flex_class = 'smi-flex-md-3'
			assign number_of_columns_on_desktop = 3
		elsif number_columns_on_desktop == '5'
			assign card_flex_class = 'smi-flex-md-4'
			assign number_of_columns_on_desktop = 4
		elsif number_columns_on_desktop == '6'
			assign card_flex_class = 'smi-flex-md-5'
			assign number_of_columns_on_desktop = 5
		endif
	when '2'
		assign media_flex_class = 'smi-flex-md-2'
		if number_columns_on_desktop == '2'	
			assign card_flex_class = 'smi-flex-md-0'
			assign media_flex_class = 'smi-flex-md-2 smi-no-slider'
		elsif number_columns_on_desktop == '3'
			assign card_flex_class = 'smi-flex-md-1'
			assign number_of_columns_on_desktop = 1
		elsif number_columns_on_desktop == '4'
			assign card_flex_class = 'smi-flex-md-2'
			assign number_of_columns_on_desktop = 2
		elsif number_columns_on_desktop == '5'
			assign card_flex_class = 'smi-flex-md-3'
			assign number_of_columns_on_desktop = 3
		elsif number_columns_on_desktop == '6'
			assign card_flex_class = 'smi-flex-md-4'
			assign number_of_columns_on_desktop = 4
		endif	
  endcase
  assign content_position_md = section.settings.desktop_content_position | split: '_'
  assign content_position = section.settings.mobile_content_position | split: '_'
-%}
{% if section.settings.type_media == 'video' %}
