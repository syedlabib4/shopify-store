    assign color_scheme = section.settings.content_color_scheme | replace: "-", "_"
-%}
<div class="smi-item smi-h-100 smi-py-xl smi-px-lg smi-gradient smi-color-{{- color_scheme -}}">
    <div class="smi-d-inline-flex smi-column-gap-md smi-mb-lg smi-align-items-center smi-item__author">
