{% comment %}#component#["settings/display-settings-2","settings/gap-between-content","settings/color-scheme","settings/section-padding","settings/section-margin","blocks/announcement","blocks/color-announcement","blocks/background","settings/icon-setting","settings/custom-icons","settings/design-mode"]#endcomponent#{% endcomment %}
<style>
    {% if block_color %}
    {% endif %}
    {% assign color_announcement_block = section.blocks | where: 'type', 'color' | first %}
{% if color_announcement_block %}
      #shopify-section-{{ section.id }},
      #shopify-section-{{ section.id }} .smi-color-{{ section.settings.color_scheme }},
      #shopify-section-{{ section.id }} .smi-block-custom-color , #shopify-section-{{ section.id }} .color-announcement {
	{% if color_announcement_block.settings.background_gradient_color == blank %}
		--gradient-background: {{ color_announcement_block.settings.background_color }};
	{% else %}
		--gradient-background: {{ color_announcement_block.settings.background_gradient_color }};
	{% endif %}
	--color-foreground: {{ color_announcement_block.settings.text_color | color_extract: 'red' }}, {{ color_announcement_block.settings.text_color | color_extract: 'green' }},{{ color_announcement_block.settings.text_color | color_extract: 'blue' }};
	--color-text-link: {{ color_announcement_block.settings.link_color | color_extract: 'red' }}, {{ color_announcement_block.settings.link_color | color_extract: 'green' }},{{ color_announcement_block.settings.link_color | color_extract: 'blue' }};
	{% if color_announcement_block.settings.hover_link_color != blank and color_announcement_block.settings.hover_link_color != 'rgba(0,0,0,0)' %}
		--color-hover-link: {{ color_announcement_block.settings.hover_link_color | color_extract: 'red' }}, {{ color_announcement_block.settings.hover_link_color | color_extract: 'green' }},{{ color_announcement_block.settings.hover_link_color | color_extract: 'blue' }};
	{% else %}
		--color-hover-link: {{ color_announcement_block.settings.link_color | color_extract: 'red' }}, {{ color_announcement_block.settings.link_color | color_extract: 'green' }},{{ color_announcement_block.settings.link_color | color_extract: 'blue' }};
	{% endif %}
    }	
{% endif %}
    #shopify-section-{{ section.id }}{
        --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
		--section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
        --gap-between-content: {{ section.settings.gap_between_content }}px;
    }
@media screen and (max-width: 767.8px){.smi-display-settings.smi-display-desktop{display:none !important}}@media screen and (min-width: 768px){.smi-display-settings.smi-display-mobile{display:none !important}}.smi-component-blocks-announcement__content{gap:var(--horizontal-space-xs)}.smi-component-blocks-announcement__content>*{color:rgba(var(--color-foreground))}.smi-component-blocks-announcement__content p{margin-bottom:0px;text-align:center}.smi-component-blocks-announcement__content .smi-component-settings-icon-setting-{width:auto}.section-class-name .smi-gap{gap:var(--gap-between-content, 30px)}.smi-component-settings-icon-setting{display:inline-flex}.smi-component-settings-icon-setting svg{stroke:rgb(var(--color-foreground))}.smi-component-settings-icon-setting svg path{fill:rgb(var(--color-foreground))}.smi-announcement-bar-2.sticky_announcement-bar{position:fixed;width:100%;top:0px;z-index:10}.smi-section-announcement-bar-2{background-color:var(--gradient-background) !important}.smi-section-announcement-bar-2.smi-section__inner{padding-top:0;padding-bottom:0}smi-scrolling-text-topbar{width:100%;display:flex;white-space:nowrap;overflow:hidden;padding-top:var(--section-padding-top, 0);padding-bottom:var(--section-padding-bottom, 0)}@media(max-width: 767.98px){smi-scrolling-text-topbar{padding-top:var(--section-padding-top-mobile, 0);padding-bottom:var(--section-padding-bottom-mobile, 0)}}smi-scrolling-text-topbar:hover .__smi-item.__smi-animation-run{animation-play-state:paused !important}smi-scrolling-text-topbar[border-top]{border-top:1px solid rgba(var(--color-foreground), 0.2)}smi-scrolling-text-topbar[border-bottom]{border-bottom:1px solid rgba(var(--color-foreground), 0.2)}smi-scrolling-text-topbar .__smi-item{display:flex;align-items:center}smi-scrolling-text-topbar .__smi-item .smi-component-blocks-announcement{overflow:hidden}smi-scrolling-text-topbar .__smi-item .smi-component-blocks-announcement{width:auto;margin-right:var(--gap-between-content)}smi-scrolling-text-topbar .__smi-item .smi-component-blocks-announcement .smi-component-settings-icon-setting->span{display:flex;height:100%;width:100%;justify-content:center;align-items:center}smi-scrolling-text-topbar .__smi-item.__smi-animation-run{animation-play-state:running !important}smi-scrolling-text-topbar .__smi-item.__smi-animation-rtl{animation:smi-marquee-rtl var(--duration, 20s) linear infinite;animation-play-state:paused}smi-scrolling-text-topbar .__smi-item.__smi-animation-ltr{animation:smi-marquee-ltr var(--duration, 20s) linear infinite;animation-play-state:paused}smi-scrolling-text-topbar .smi-outline-text{-webkit-text-stroke:1px rgb(var(--color-foreground));-webkit-text-fill-color:rgba(0,0,0,0)}@keyframes smi-marquee-rtl{0%{transform:translate(0%)}100%{transform:translate(-100%)}}@keyframes smi-marquee-ltr{0%{transform:translate(-100%)}100%{transform:translate(0%)}}
</style>
<div id="smi-{{ section.id }}" class="smi-{{ section.id }} smi-display-settings smi-display-{{ section.settings.display_on }} smi-section__inner smi-gradient smi-section-announcement-bar-2 {% if section.settings.enable_sticky_bar %} sticky_announcement-bar{% endif %} smi-color-{{ section.settings.color_scheme }}" data-section="announcement-bar-2" data-name="✧Announcement bar 2">
    
    {% liquid
    assign background_block = section.blocks | where: 'type', 'background' | first
    if background_block
      render 'smi-background', section: section, is_reference: true
    endif
  %}
    <div class="smi-w-100">
        <smi-scrolling-text-topbar speed="{{ section.settings.scrolling_speed }}">
            <div class="__smi-item {{ section.settings.scroll_direction | prepend: '__smi-animation-' }}">
                {% for block in section.blocks %}
                    {% case block.type %}
                        {% when 'announcement' %}
                            {% style %}
                                #shopify-section-{{ section.id }} .smi-component-blocks-announcement__content .smi-component-settings-icon-setting- {
                                width: {{ block.settings.icon_size }}px;
                                height: {{ block.settings.icon_size }}px;
                            }
                            {% endstyle %}
<div class="smi-component-blocks-announcement">
    <div class="smi-component-blocks-announcement__content smi-format-content smi-text-sm smi-link-wrapper smi-d-flex smi-justify-content-center smi-align-items-center smi-link-wrapper">
        {% if block.settings.icon != blank and block.settings.icon != 'none' %}
            {% if images[block.settings.upload_icon] != blank or block.settings.icon != 'none' %}
<div class="smi-component-settings-icon-setting- smi-component-settings-icon-setting-{{ block.id }} ">
    <style>
        .smi-component-settings-icon-setting-{{ block.id }} span,
        .smi-component-settings-icon-setting-{{ block.id }} img {
            width: {{ block.settings.icon_size }}px;
            height: {{ block.settings.icon_size }}px;
            object-fit: cover;
        }
        .smi-component-settings-icon-setting-{{ block.id }} svg {
            width: {{ block.settings.icon_size }}px;
            height: {{ block.settings.icon_size }}px;
            object-fit: cover;
        }
    </style>
    <span class="smi-d-block">
        {%- if images[block.settings.upload_icon] != blank -%}
            {{ images[block.settings.upload_icon] | image_url: width: 750, height: 750 | image_tag: loading: 'eager' }}
        {%- else -%}
            {% if block.settings.icon != 'none' and block.settings.icon != "" %}
                {%- render 'smi-custom-icons', icon: block.settings.icon -%}
            {% endif %}
        {%- endif -%}
    </span>
    </div>
{% endif %}
        {% endif %}
        {{block.settings.content}}
    </div>
</div>
                    {% endcase %}
                {% endfor %}
            </div>
        </smi-scrolling-text-topbar>
    </div>
</div>

<script src="{{ 'smi-announcement-bar-2.min.js' | asset_url }}" defer data-id="smi-announcement-bar-2"></script>
