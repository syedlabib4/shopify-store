  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
--section-padding-bottom: {{ section.settings.padding_bottom }}px;
--section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
--section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
;
    {% assign countdownBlock = section.blocks | where: 'type', 'countdown_timer' | first %}
{% assign announcement = section.blocks | where: 'type', 'announcement-2' | first %}
{% if countdownBlock or announcement %}
    {% if countdownBlock.settings.number_size == 'smi-h1' or announcement.settings.number_size == 'smi-h1' %}
        --unit-size: var(--h1-font-size);
        --unit-size-min: 22px;
        --unit-line-height: 22;
        --unit-line-height-min: 22;
		--min-width-num: 58px;
		@media screen and (max-width: 768px) {
			--min-width-num: 32px;
		}
    {% elsif countdownBlock.settings.number_size == 'smi-h2' or announcement.settings.number_size == 'smi-h2' %}
        --unit-size: var(--h2-font-size);
        --unit-size-min: 20px;
        --unit-line-height: 20;
        --unit-line-height-min: 20;
		--min-width-num: 48px;
		@media screen and (max-width: 768px) {
			--min-width-num: 30px;
		}
    {% elsif countdownBlock.settings.number_size == 'smi-h3' or announcement.settings.number_size == 'smi-h3' %}
        --unit-size: var(--h3-font-size);
        --unit-size-min: 18px;
        --unit-line-height: 18;
        --unit-line-height-min: 18;
		--min-width-num: 35px;
		@media screen and (max-width: 768px) {
			--min-width-num: 28px;
		}
    {% elsif countdownBlock.settings.number_size == 'smi-h4' or announcement.settings.number_size == 'smi-h4' %}
        --unit-size: var(--h4-font-size);
        --unit-size-min: 16px;
        --unit-line-height: 16;
        --unit-line-height-min: 16;
		--min-width-num: 27px;
		@media screen and (max-width: 768px) {
			--min-width-num: 26px;
		}
    {% endif %}
	{% if countdownBlock.settings.font_type == 'body' or announcement.settings.font_type == 'body' %}
        --unit-size: 16px;
        --unit-size-min: 16px;
        --unit-line-height: 22;
        --unit-line-height-min: 22;
		--min-width-num: 27px;
		@media screen and (max-width: 768px) {
			--min-width-num: 26px;
		}
	{% endif %}
    .smi-rich-content-40{
        {% if countdownBlock.settings.number_size == 'smi-h1' or announcement.settings.number_size == 'smi-h1' %}
            --unit-size: var(--h1-font-size);
            --unit-size-min: 20px;
            --unit-line-height: 20;
            --unit-line-height-min: 20;
        {% elsif countdownBlock.settings.number_size == 'smi-h2' or announcement.settings.number_size == 'smi-h2' %}
            --unit-size: var(--h2-font-size);
            --unit-size-min: 18px;
            --unit-line-height: 18;
            --unit-line-height-min: 18;
        {% elsif countdownBlock.settings.number_size == 'smi-h3' or announcement.settings.number_size == 'smi-h3' %}
            --unit-size: var(--h3-font-size);
            --unit-size-min: 16px;
            --unit-line-height: 16;
            --unit-line-height-min: 16;
        {% elsif countdownBlock.settings.number_size == 'smi-h4' or announcement.settings.number_size == 'smi-h4' %}
            --unit-size: var(--h4-font-size);
            --unit-size-min: 14px;
            --unit-line-height: 14;
            --unit-line-height-min: 14;
        {% endif %}
		{% if countdownBlock.settings.font_type == 'body' or announcement.settings.font_type == 'body' %}
			--unit-size: 16px;
			--unit-size-min: 16px;
			--unit-line-height: 22;
			--unit-line-height-min: 22;
			--min-width-num: 27px;
			@media screen and (max-width: 768px) {
				--min-width-num: 26px;
			}
		{% endif %}
    }
{% endif %}
	--section-margin-sides: {{ section.settings.margin_sides }}px;
--section-margin-sides-mobile: {{ section.settings.margin_sides_mobile }}px;
	{% if  section.settings.custom_width == true and section.settings.full_width == false %}
--page-width: {{ section.settings.section_width }}px;
{% endif %}
    --heading-alignment: {{ section.settings.content_alignment }};
    --no-padding-bottom:{% if section.settings.padding_bottom == 0 %}24px{% else %}0px{% endif %};
    --no-padding-top:{% if section.settings.padding_top == 0 %}36px{% else %}0px{% endif %};
	--content-alignment: {{ section.settings.content_alignment }};
  }
  #smi-{{ section.id }} .smi-heading-component .smi-heading-inner {
	text-align: {{ section.settings.content_alignment }};
  }
