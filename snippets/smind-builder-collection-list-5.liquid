		--color-button-text: {{ block_color.settings.content_solid_button_label_color | color_extract: 'red' }}, {{ block_color.settings.content_solid_button_label_color | color_extract: 'green' }},{{ block_color.settings.content_solid_button_label_color | color_extract: 'blue' }};
		{% if block_color.settings.content_solid_background_button_hover_color != blank and block_color.settings.content_solid_background_button_hover_color != 'rgba(0,0,0,0)' %}
			--color-button-hover: {{ block_color.settings.content_solid_background_button_hover_color | color_extract: 'red' }}, {{ block_color.settings.content_solid_background_button_hover_color | color_extract: 'green' }},{{ block_color.settings.content_solid_background_button_hover_color | color_extract: 'blue' }};
		{% else %}
			--color-button-hover: {{ block_color.settings.content_solid_background_button_color | color_extract: 'red' }}, {{ block_color.settings.content_solid_background_button_color | color_extract: 'green' }},{{ block_color.settings.content_solid_background_button_color | color_extract: 'blue' }};
		{% endif %}		
